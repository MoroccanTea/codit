<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- codit-expect: CWE-548 IIS directory browsing enabled -->
    <directoryBrowse enabled="true" />
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\Acme.Web.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
  </system.webServer>
</configuration>
