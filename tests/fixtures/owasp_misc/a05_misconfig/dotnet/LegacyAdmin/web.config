<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- codit-expect: CWE-489 debug compilation enabled on the deployed site -->
    <compilation debug="true" targetFramework="4.8" />



    <!-- codit-expect: CWE-209 custom errors off, raw ASP.NET error pages shown to remote users -->
    <customErrors mode="Off" />



    <httpRuntime targetFramework="4.8" enableVersionHeader="true" />
  </system.web>
</configuration>
