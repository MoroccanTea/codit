<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.acme</groupId>
    <artifactId>billing-service</artifactId>
    <version>3.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>

    <repositories>
        <repository>
            <id>acme-internal</id>
            <!-- codit-expect: CWE-829 Maven repository over plain http -->
            <url>http://repo.acme.local/maven2</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <!-- codit-expect: CWE-1104 log4j-core 2.14.1 (Log4Shell, CVE-2021-44228) -->
            <version>2.14.1</version>
        </dependency>



        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <!-- codit-expect: CWE-1104 spring-core 5.3.17 (Spring4Shell, CVE-2022-22965) -->
            <version>5.3.17</version>
        </dependency>



        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- codit-safe: CWE-1104 current jackson-databind release -->
            <version>2.18.0</version>
        </dependency>
    </dependencies>
</project>
